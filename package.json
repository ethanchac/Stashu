{
  "name": "stashu",
  "version": "1.0.0",
  "private": true,
  "description": "Personal multi-channel storage and organization app",
  "workspaces": [
    "backend",
    "web",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run dev --workspace=mobile",
    "install:all": "npm install && npm install --workspaces"
  },
  "keywords": [
    "personal",
    "storage",
    "organization",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "metro": "^0.81.0",
    "metro-cache": "^0.83.3",
    "metro-config": "^0.83.3",
    "metro-core": "^0.83.3",
    "metro-resolver": "^0.83.3",
    "metro-runtime": "^0.81.0",
    "metro-transform-worker": "^0.83.3"
  }
}
